# Frontend (Vite) environment
# Point this at the LifeFlow API to enable cloud sync. Defaults to the Vite proxy (/api).
VITE_API_URL=/api

# ─── Google Sheets cloud sync (Apps Script Web App) ──────────────────────────
# Deploy google-apps-script/Code.gs as a Web App, paste its /exec URL here.
# Khaali chhodoge → app localStorage-only mode me chalegi (no sync, no crash).
VITE_SHEETS_API_URL=
# Optional: agar Code.gs me SECRET set kiya hai to wahi value yahan (warna khaali).
VITE_SHEETS_TOKEN=
